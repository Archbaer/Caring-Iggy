# Node / frontend
**/node_modules/
**/.next/
**/out/
**/dist/
**/coverage/
**/*.tsbuildinfo

# Java / Maven
**/target/
**/.mvn/
**/*.class

# Agent tooling (not committed)
.agents/
.claude/
.remember/
.opencode/

# IDE / editor artifacts
**/.classpath
**/.project
**/.factorypath
**/.settings/
.idea/
.vscode/

# Logs and local runtime files
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# Environment files
.env
opencode.json
CLAUDE.md
AGENTS.md


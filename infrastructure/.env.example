# Local Docker Compose defaults
DB_USER=postgres
DB_PASSWORD=postgres

# Backend service URLs (matching/reporting/user-service use Docker service names)
ANIMAL_SERVICE_URL=http://animal-service:8081
USER_SERVICE_URL=http://user-service:8085
ADOPTER_SERVICE_URL=http://adopter-service:8082

# JWT_PRIVATE_KEY / JWT_PUBLIC_KEY / JWT_KEY_ID are written by kong/bootstrap-keys.sh — do not hand-edit

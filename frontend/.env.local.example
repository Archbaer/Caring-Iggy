# Backend microservice URLs
ANIMAL_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8085
ADOPTER_SERVICE_URL=http://localhost:8082
REPORTING_SERVICE_URL=http://localhost:8084

# Internal base URL used for server-to-server BFF calls
INTERNAL_BASE_URL=http://localhost:3000

# Session signing secret — any long random string (e.g. openssl rand -hex 32)
AUTH_SESSION_STATE_SECRET=change-me-use-a-long-random-secret

# CSRF signing secret — any long random string, different from session secret
AUTH_CSRF_SECRET=change-me-use-a-different-long-random-secret

# Trusted origin for CSRF validation — must match the URL you open in the browser
APP_ORIGIN=http://localhost:3000
